  "type": {
    "families": {
      "display": { "name": "Anton", "weights": [400], "googleFonts": "GoogleFonts.anton" },
      "ui": { "name": "Archivo", "weights": [400, 500, 600, 700, 800], "googleFonts": "GoogleFonts.archivo" },
      "mono": { "name": "DM Mono", "weights": [400, 500], "googleFonts": "GoogleFonts.dmMono" }
    },
    "fallback": { "display": "Impact, sans-serif", "ui": "system-ui, sans-serif", "mono": "monospace" },
    "antonLadder": {
      "46": "home hero, product-tile initial",
      "44": "payment amount",
      "42": "confirmation title",
      "40": "tab-screen titles (line-height .95)",
      "34": "order shop/customer name, status headings, product price",
      "32": "storefront name, product title",
      "30": "promo headline",
      "28": "shop stats number",
      "26": "sub-screen titles, account name, cart total, filter sheet title",
      "24": "payment status title, my-shop name, review sheet name, dialog title, grand total",
      "22": "checkout step headings, order totals",
      "20": "initials / marks (large)",
      "14": "initials / marks (small), tab-bar mark"
    },
    "styles": {
      "sectionLabel": { "family": "mono", "weight": 500, "size": 9, "tracking": 0.16, "case": "upper", "colour": "faint" },
      "inputLabel": { "family": "mono", "weight": 500, "size": 9, "tracking": 0.14, "case": "upper", "colour": "faint" },
      "meta": { "family": "mono", "weight": 500, "size": 10, "tracking": 0.08, "case": "upper", "colour": "faint" },
      "metaLarge": { "family": "mono", "weight": 500, "size": 11, "tracking": 0.1, "case": "upper", "colour": "mute" },
