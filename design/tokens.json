      "body": { "family": "ui", "weight": 400, "size": 13, "lineHeight": 1.5, "colour": "mute" },
      "bodyStrong": { "family": "ui", "weight": 600, "size": 13, "lineHeight": 1.3, "colour": "ink" },
      "cardTitle": { "family": "ui", "weight": 700, "size": 15, "lineHeight": 1.3, "colour": "ink" },
      "inputText": { "family": "ui", "weight": 500, "size": 14, "colour": "ink" },
      "error": { "family": "ui", "weight": 500, "size": 11, "colour": "danger" },
      "price": { "family": "ui", "weight": 700, "size": 14, "colour": "ink" },
      "priceStrike": { "family": "ui", "weight": 400, "size": 11, "colour": "faint" },
      "buttonPrimary": { "family": "ui", "weight": 700, "size": 14 },
      "buttonSecondary": { "family": "ui", "weight": 600, "size": 13 },
      "chip": { "family": "ui", "weight": 600, "size": 12 },
      "statusChip": { "family": "ui", "weight": 700, "size": 10 },
      "tabLabel": { "family": "ui", "weight": 600, "size": 9 },
      "badge": { "family": "ui", "weight": 700, "size": 9 }
    }
  },
  "radius": { "pill": 99, "sheetTop": 28, "dialog": 24, "promo": 22, "tabPill": 22, "card": 20, "tile": 18, "button": 16, "input": 14, "buttonSmall": 14, "stepper": 14, "retry": 12, "tabItem": 15, "cartStepper": 10, "skeletonLine": 6, "grabber": 2 },
  "spacing": {
    "screenPadding": 20,
    "stickyBarPadding": 16,
    "gridGapX": 12,
    "gridGapY": 18,
    "skeletonGridGapY": 16,
    "sectionGap": 24,
    "cardPadding": 16,
    "tabBarContentPad": 130,
    "unit": 4
  },
  "borders": { "hairline": 1, "emphasis": 1.5, "tickRing": 4, "dashed": "1.5px dashed line2" },
  "shadow": { "ctaGlow": "0 10px 24px -12px rgba(255,165,31,.8)", "promoGlow": "0 14px 30px -18px rgba(255,165,31,.9)", "confirmGlow": "0 20px 40px -18px rgba(255,165,31,.9)", "cards": "none" },
  "motion": {
    "cydIn": { "ms": 400, "curve": "cubic-bezier(.19,1,.22,1)", "effect": "translateY 12->0 + fade in" },
    "cydInToast": { "ms": 300, "curve": "cubic-bezier(.19,1,.22,1)" },
    "cydShim": { "ms": 1400, "curve": "ease-in-out", "repeat": true, "effect": "opacity .45 -> .9 -> .45" },
    "cydShimChecking": { "ms": 1000, "curve": "ease-in-out", "repeat": true },
    "cydPulse": { "ms": 1800, "curve": "ease-out", "repeat": true, "effect": "scale .9->1.35, opacity .6->0", "secondRingDelayMs": 900 },
    "cydPop": { "ms": 600, "curve": "cubic-bezier(.19,1,.22,1)", "effect": "scale .6 -> 1.08 -> 1" },
    "cydPopDialog": { "ms": 300, "curve": "cubic-bezier(.19,1,.22,1)" },
    "cydSheet": { "ms": 420, "curve": "cubic-bezier(.19,1,.22,1)", "effect": "translateY 102% -> 0" },
    "cydVeilSheet": { "ms": 250, "curve": "ease" },
    "cydVeilDialog": { "ms": 200, "curve": "ease" },
    "press": { "ms": 180, "scale": 0.97, "targets": "product card, category tile" },
    "galleryDot": { "ms": 300, "widthFrom": 6, "widthTo": 18 },
    "stepBar": { "ms": 300 },
    "tabBg": { "ms": 300 },
    "switch": { "ms": 200 },
    "toastAutoDismissMs": 2800
  },
  "tabBar": {
    "outerPadding": { "top": 10, "horizontal": 14, "bottom": 18 },
    "gradient": "to top, bg 60%, transparent",
    "pill": { "gap": 4, "padding": 8, "radius": 22, "blur": 20, "border": "1px line" },
    "item": { "padding": "11 4 9", "radius": 15, "gap": 5, "markFont": "Anton 14", "labelFont": "Archivo 600 9" },
    "selected": { "bg": "#FFA51F", "fg": "#0A0A0B" },
    "unselected": { "bg": "transparent", "fg": "mute" },
    "badge": { "tabs": [ { "tab": "cart", "counts": "total quantity" }, { "tab": "shop", "counts": "action-count.total (designed here)" } ], "top": 4, "right": 14, "minSize": 16, "paddingH": 4, "radius": 99, "bg": "danger", "fg": "#FFFFFF", "font": "Archivo 700 9" },
    "totalHeight": 92,
    "cartSummaryBarBottom": 92,
    "toastBottom": { "withTabs": 104, "stickyBarScreens": 100, "other": 30 },
    "tabs": [
      { "key": "id", "mark": "ID", "label": "My ID", "roles": ["holder"], "route": "/id" },
      { "key": "profiles", "mark": "P", "label": "Profiles", "roles": ["admin", "user"], "route": "/id" },
      { "key": "shop", "mark": "S", "label": "Shop", "route": "/shop" },
      { "key": "cart", "mark": "₹", "label": "Cart", "route": "/cart" },
      { "key": "orders", "mark": "O", "label": "Orders", "route": "/orders" },
      { "key": "account", "mark": "A", "label": "Account", "route": "/account" }
    ],
    "note": "First tab is role-based (My ID for holders, Profiles for admin/user): 5 tabs visible at a time."
  },
  "sizes": {
    "referenceViewport": { "width": 390, "height": 844 },
    "minTapTarget": 44,
    "buttonHeights": { "cta": 56, "primary": 54, "primaryMid": 52, "inline": 50, "compact": 46, "retry": 44 },
    "backButton": 40,
    "iconTile": 56,
    "avatar": { "home": 42, "account": 56, "myShop": 52, "storefrontLogo": 84, "sellerStateGlyph": 96, "confirmTick": 104 },
    "inputHeight": 50,
    "chipHeight": 36,
    "statusChipHeight": { "list": 24, "detail": 26, "compact": 22 },
    "productTileAspect": "4/5",
    "stepperProduct": { "height": 52, "button": [40, 50], "countWidth": 22 },
    "stepperCart": { "height": 34, "button": [32, 32], "countWidth": 20, "disabledOpacity": 0.35 },
    "switch": { "width": 44, "height": 26, "knob": 22 },
    "radio": { "size": 20, "dot": 10, "border": 2 },
    "grabber": { "width": 40, "height": 4 }
  }
}
